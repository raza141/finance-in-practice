# Copy to .env.local. NEXT_PUBLIC_* values are inlined into the browser bundle
# at build time: never put secrets here.

# FastAPI quant backend origin (QuantApiClient appends /api/v1/...)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cal.com event to embed in the booking section, e.g. your-handle/30min.
# Leave empty to show the "coming online shortly" placeholder.
NEXT_PUBLIC_CAL_LINK=
NEXT_PUBLIC_CAL_ORIGIN=https://cal.com

# Server-only Cal.com API key (Phase 3 live availability). No NEXT_PUBLIC_
# prefix, so it is never sent to the browser. Set the real value in
# .env.local and in Vercel project settings, never in this file.
CAL_API_KEY=

# Neon Postgres connection string (testimonials, admin panel). Added by the
# Neon integration in Vercel; copy it into .env.local for local dev, then run
# `npm run db:migrate`. Never put the real value in this file.
DATABASE_URL=

# Admin panel (/admin). Who may sign in is the admin_users table; add people
# with `npm run admin:add -- --email you@example.com --name "Your Name"`.
# "Continue with Google" appears only when both Google values are set. Create
# an OAuth client (Web) in Google Cloud and register these redirect URIs:
#   https://financeinpractice.me/api/admin/auth/google/callback
#   http://localhost:3000/api/admin/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public Vercel Blob URL of the Market Pulse JSON that PortX uploads daily,
# e.g. https://<store>.public.blob.vercel-storage.com/market-pulse/latest.json
# Unset: development shows the bundled sample; production shows "Data unavailable".
MARKET_PULSE_URL=

# Vercel Blob read-write token for instructor photo uploads in /admin/instructors.
# Connecting a Blob store to the Vercel project sets it automatically; copy it here for local uploads.
BLOB_READ_WRITE_TOKEN=
