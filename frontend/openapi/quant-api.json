  "components": {
    "schemas": {
      "AssetClass": {
        "type": "string",
        "enum": [
          "equity",
          "fixed_income",
          "credit",
          "commodity",
          "real_estate",
          "fx",
          "cash"
        ],
        "title": "AssetClass"
      },
      "BlackScholesRequest": {
        "properties": {
          "spot": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Spot"
          },
          "strike": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Strike"
          },
          "time_to_expiry": {
            "type": "number",
            "maximum": 50.0,
            "exclusiveMinimum": 0.0,
            "title": "Time To Expiry",
            "description": "Years"
          },
          "rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -0.1,
            "title": "Rate",
            "description": "Continuously compounded risk-free rate"
          },
          "dividend_yield": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Dividend Yield",
            "default": 0.0
          },
          "option_type": {
            "$ref": "#/components/schemas/OptionType",
            "default": "call"
          },
          "volatility": {
            "type": "number",
            "maximum": 5.0,
            "exclusiveMinimum": 0.0,
            "title": "Volatility",
            "description": "Annualised, 0.2 = 20%"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "spot",
          "strike",
          "time_to_expiry",
          "rate",
          "volatility"
        ],
        "title": "BlackScholesRequest"
      },
      "BlackScholesResponse": {
        "properties": {
          "price": {
            "type": "number",
            "title": "Price"
          },
          "d1": {
            "type": "number",
            "title": "D1"
          },
          "d2": {
            "type": "number",
            "title": "D2"
          },
          "delta": {
            "type": "number",
            "title": "Delta"
          },
          "gamma": {
            "type": "number",
            "title": "Gamma"
          },
          "vega": {
            "type": "number",
            "title": "Vega",
            "description": "Per 1.00 change in volatility"
          },
          "theta": {
            "type": "number",
            "title": "Theta",
            "description": "Per year"
          },
          "rho": {
            "type": "number",
            "title": "Rho",
            "description": "Per 1.00 change in rate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "price",
          "d1",
          "d2",
          "delta",
          "gamma",
          "vega",
          "theta",
          "rho"
        ],
        "title": "BlackScholesResponse"
      },
      "BondRequest": {
        "properties": {
          "face": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Face",
            "default": 100.0
          },
          "coupon_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Coupon Rate",
            "description": "Annual, 0.05 = 5%"
          },
          "maturity_years": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Maturity Years"
          },
          "frequency": {
            "type": "integer",
            "enum": [
              1,
              2,
              4,
              12
            ],
            "title": "Frequency",
            "default": 2
          },
          "compounding": {
            "$ref": "#/components/schemas/Compounding",
            "default": "periodic"
          },
          "ytm": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5.0,
                "minimum": -0.5
              },
              {
                "type": "null"
              }
            ],
            "title": "Ytm"
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "coupon_rate",
          "maturity_years"
        ],
        "title": "BondRequest"
      },
      "BondResponse": {
        "properties": {
          "price": {
            "type": "number",
            "title": "Price"
          },
          "ytm": {
            "type": "number",
            "title": "Ytm"
          },
          "macaulay_duration": {
            "type": "number",
            "title": "Macaulay Duration"
          },
          "modified_duration": {
            "type": "number",
            "title": "Modified Duration"
          },
          "convexity": {
            "type": "number",
            "title": "Convexity"
          },
          "cash_flows": {
            "items": {
              "$ref": "#/components/schemas/CashFlowOut"
            },
            "type": "array",
            "title": "Cash Flows"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "price",
          "ytm",
          "macaulay_duration",
          "modified_duration",
          "convexity",
          "cash_flows"
        ],
        "title": "BondResponse"
      },
      "BootstrapRequest": {
        "properties": {
          "instruments": {
            "items": {
              "$ref": "#/components/schemas/CurveInstrumentIn"
            },
            "type": "array",
            "maxItems": 60,
            "minItems": 1,
            "title": "Instruments"
          },
          "frequency": {
            "type": "integer",
            "enum": [
              1,
              2,
              4,
              12
            ],
            "title": "Frequency",
            "default": 2
          },
          "face": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Face",
            "default": 100.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "instruments"
        ],
        "title": "BootstrapRequest"
      },
      "BootstrapResponse": {
        "properties": {
          "points": {
            "items": {
              "$ref": "#/components/schemas/ZeroPointOut"
            },
            "type": "array",
            "title": "Points"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "points"
        ],
        "title": "BootstrapResponse"
      },
      "CashFlowOut": {
        "properties": {
          "time": {
            "type": "number",
            "title": "Time"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "present_value": {
            "type": "number",
            "title": "Present Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "time",
          "amount",
          "present_value"
        ],
        "title": "CashFlowOut"
      },
      "Compounding": {
        "type": "string",
        "enum": [
          "periodic",
          "continuous"
        ],
        "title": "Compounding"
      },
      "CurveInstrumentIn": {
        "properties": {
          "maturity": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Maturity"
          },
          "coupon_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Coupon Rate",
            "default": 0.0
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Price"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "maturity",
          "price"
        ],
        "title": "CurveInstrumentIn"
      },
      "Distribution": {
        "type": "string",
        "enum": [
          "normal",
          "student_t"
        ],
        "title": "Distribution"
      },
      "FrontierRequest": {
        "properties": {
          "assets": {
            "items": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 2,
            "title": "Assets"
          },
          "expected_returns": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Returns",
            "description": "Annualised"
          },
          "covariance": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Covariance",
            "description": "Annualised"
          },
          "returns": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "array",
                "maxItems": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Returns",
            "description": "Periodic returns, T rows x N columns; annualised internally"
          },
          "periods_per_year": {
            "type": "integer",
            "enum": [
              12,
              52,
              252
            ],
            "title": "Periods Per Year",
            "default": 252
          },
          "risk_free_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -0.1,
            "title": "Risk Free Rate",
            "default": 0.0
          },
          "long_only": {
            "type": "boolean",
            "title": "Long Only",
            "default": true
          },
          "max_weight": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Weight"
          },
          "n_points": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 5.0,
            "title": "N Points",
            "default": 50
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "assets"
        ],
        "title": "FrontierRequest"
      },
      "FrontierResponse": {
        "properties": {
          "points": {
            "items": {
              "$ref": "#/components/schemas/PortfolioOut"
            },
            "type": "array",
            "title": "Points"
          },
          "min_variance": {
            "$ref": "#/components/schemas/PortfolioOut"
          },
          "tangency": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PortfolioOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "points",
          "min_variance",
          "tangency"
        ],
        "title": "FrontierResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoricalVaRRequest": {
        "properties": {
          "positions": {
            "items": {
              "$ref": "#/components/schemas/Position"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Positions"
          },
          "returns": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "maxItems": 5000,
            "minItems": 1,
            "title": "Returns",
            "description": "Daily returns, T rows x N columns in the same order as positions"
          },
          "confidence": {
            "type": "number",
            "maximum": 0.999,
            "minimum": 0.9,
            "title": "Confidence",
            "description": "VaR confidence level, e.g. 0.99",
            "default": 0.99
          },
          "horizon_days": {
            "type": "integer",
            "maximum": 250.0,
            "minimum": 1.0,
            "title": "Horizon Days",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "positions",
          "returns"
        ],
        "title": "HistoricalVaRRequest"
      },
      "ImpliedVolRequest": {
        "properties": {
          "spot": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Spot"
          },
          "strike": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Strike"
          },
          "time_to_expiry": {
            "type": "number",
            "maximum": 50.0,
            "exclusiveMinimum": 0.0,
            "title": "Time To Expiry",
            "description": "Years"
          },
          "rate": {
