# The website the gateway polls (use http://localhost:3000 to test against `next dev`).
SITE_URL=https://financeinpractice.me
# Same value as WHATSAPP_GATEWAY_SECRET on Vercel. Make one with: openssl rand -hex 32
WHATSAPP_GATEWAY_SECRET=
# Seconds between polls when idle (each poll wakes the database). Default 60.
POLL_SECONDS=60
# Optional: where the WhatsApp session is kept (default ./auth) and Chrome's path.
# AUTH_DIR=auth
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
