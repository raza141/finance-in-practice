# Root environment for docker compose. Copy to .env and adjust.
# Never commit the real .env.

# --- quant-backend --------------------------------------------------------
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT=60/minute
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
# Proxies trusted for X-Forwarded-For. Use the load balancer's IP, or * only
# when the API is reachable solely through a trusted proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- frontend (Phase 2) ---------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
